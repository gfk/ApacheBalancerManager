{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient.watchdog-probe": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApacheManagement": {
    "Servers": [
      {
        "Id": "lb-01",
        "Name": "lb-01",
        "BaseUrl": "http://10.0.0.11"
      },
      {
        "Id": "lb-02",
        "Name": "lb-02",
        "BaseUrl": "http://10.0.0.12"
      }
    ]
  },
  "Watchdog": {
    "Enabled": false,
    "DryRun": true,
    "PollIntervalSeconds": 10,
    "FailuresBeforeDisable": 3,
    "SuccessesBeforeEnable": 6,
    "MaxActionsPerHour": 6,
    "StateFilePath": null,
    "CustomRootCertificatePath": null,
    "Targets": [
      {
        "Id": "web-public@app-1",
        "PeerTargetId": "web-public@app-2",
        "BalancerName": "web-public-backend",
        "WorkerUrl": "https://web-public.app-1.example.com",
        "Probe": {
          "Url": "https://web-public.app-1.example.com/health",
          "TimeoutSeconds": 5,
          "MaxLatencyMilliseconds": 2000,
          "ExpectedStatusCodes": [ 200 ],
          "ExpectedBodyFragment": "OK"
        }
      },
      {
        "Id": "web-public@app-2",
        "PeerTargetId": "web-public@app-1",
        "BalancerName": "web-public-backend",
        "WorkerUrl": "https://web-public.app-2.example.com",
        "Probe": {
          "Url": "https://web-public.app-2.example.com/health",
          "TimeoutSeconds": 5,
          "MaxLatencyMilliseconds": 2000,
          "ExpectedStatusCodes": [ 200 ],
          "ExpectedBodyFragment": "OK"
        }
      }
    ]
  }
}
