{
  "openapi": "3.0.4",
  "info": {
    "title": "Apache Balancer Manager BFF",
    "description": "Unified REST facade over the mod_proxy_balancer /balancer-manager pages of multiple Apache 2.4 servers.",
    "version": "v1"
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "ApacheBalancerBFF"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/balancer/status": {
      "get": {
        "tags": [
          "Balancer"
        ],
        "summary": "Returns the balancer and worker status of every configured Apache server.",
        "description": "All servers are queried concurrently. Unreachable servers do not fail the request:\nthey are reported in the `Errors` array while reachable servers are returned\nin `SuccessData` (partial success, always HTTP 200).",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerStatusDtoMultiServerResponseDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/balancer/worker/status": {
      "post": {
        "tags": [
          "Balancer"
        ],
        "summary": "Changes the status of a single worker on a single Apache server.",
        "description": "The BFF first fetches the server's balancer-manager page to obtain a fresh per-balancer\nnonce, then submits the form-encoded modification POST that the native UI would send,\nand finally returns the worker's post-action state scraped from Apache's response.\n            \nValid `ActionType` values (case-insensitive): Enable, Disable, Drain, Stop,\nDisableOff, DrainOff, StopOff, IgnoreErrorsOn, IgnoreErrorsOff, HotStandbyOn,\nHotStandbyOff, HotSpareOn, HotSpareOff, HcFailOn, HcFailOff.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkerActionRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkerActionRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/WorkerActionRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The action was applied; the body contains the worker's new status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkerActionResultDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ServerId, BalancerName, WorkerUrl or ActionType.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "The Apache server could not be reached or rejected the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BalancerStatusDto": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string",
            "description": "Pool name without the \"balancer://\" scheme or the per-process prefix (e.g. \"web-public-backend\").",
            "nullable": true
          },
          "Nonce": {
            "type": "string",
            "description": "Per-balancer nonce required by Apache to accept modification requests.",
            "nullable": true
          },
          "MaxMembers": {
            "type": "string",
            "description": "Raw \"MaxMembers\" cell (e.g. \"2 [2 Used]\").",
            "nullable": true
          },
          "StickySession": {
            "type": "string",
            "description": "Sticky session configuration (\"(None)\" when disabled).",
            "nullable": true
          },
          "DisableFailover": {
            "type": "string",
            "description": "Whether failover is disabled (\"On\"/\"Off\").",
            "nullable": true
          },
          "Timeout": {
            "type": "string",
            "description": "Balancer timeout.",
            "nullable": true
          },
          "FailoverAttempts": {
            "type": "string",
            "description": "Number of failover attempts.",
            "nullable": true
          },
          "Method": {
            "type": "string",
            "description": "Load-balancing method (e.g. \"byrequests\", \"bybusyness\").",
            "nullable": true
          },
          "Path": {
            "type": "string",
            "description": "Mount path of the balancer.",
            "nullable": true
          },
          "Active": {
            "type": "string",
            "description": "Whether the balancer is active (\"Yes\"/\"No\").",
            "nullable": true
          },
          "Workers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkerStatusDto"
            },
            "description": "The pool's backend workers.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "One balancer pool (balancer://name) scraped from a balancer-manager page."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "ServerErrorDto": {
        "type": "object",
        "properties": {
          "ServerId": {
            "type": "string",
            "description": "Configured identifier of the failing server (e.g. \"lb-02\").",
            "nullable": true
          },
          "ErrorMessage": {
            "type": "string",
            "description": "Human-readable description of the failure (e.g. \"Connection timed out\").",
            "nullable": true
          },
          "Timestamp": {
            "type": "string",
            "description": "Moment the failure was observed (UTC).",
            "format": "date-time"
          }
        },
        "additionalProperties": false,
        "description": "Error payload for a single Apache server that could not be queried."
      },
      "ServerStatusDto": {
        "type": "object",
        "properties": {
          "ServerId": {
            "type": "string",
            "description": "Configured identifier of the server (e.g. \"lb-01\").",
            "nullable": true
          },
          "ServerName": {
            "type": "string",
            "description": "Configured display name of the server.",
            "nullable": true
          },
          "BaseUrl": {
            "type": "string",
            "description": "Configured base URL of the server.",
            "nullable": true
          },
          "Balancers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BalancerStatusDto"
            },
            "description": "All balancer pools found on the server's /balancer-manager page.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Scraped balancer-manager state of one Apache server."
      },
      "ServerStatusDtoMultiServerResponseDto": {
        "type": "object",
        "properties": {
          "SuccessData": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServerStatusDto"
            },
            "description": "Successfully scraped data, one entry per reachable server.",
            "nullable": true
          },
          "Errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServerErrorDto"
            },
            "description": "Detailed error payloads for the servers that could not be queried.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Top-level partial-success wrapper. Successfully scraped servers land in\nApacheBalancerBFF.Dtos.MultiServerResponseDto`1.SuccessData; unreachable or failed servers land in ApacheBalancerBFF.Dtos.MultiServerResponseDto`1.Errors.\nThe HTTP status is 200 even when some servers failed."
      },
      "WorkerActionRequestDto": {
        "required": [
          "ActionType",
          "BalancerName",
          "ServerId",
          "WorkerUrl"
        ],
        "type": "object",
        "properties": {
          "ServerId": {
            "minLength": 1,
            "type": "string",
            "description": "Configured identifier of the target Apache server (e.g. \"lb-01\")."
          },
          "BalancerName": {
            "minLength": 1,
            "type": "string",
            "description": "Balancer pool containing the worker (e.g. \"web-public-backend\"). Required because the same worker URL can belong to several pools."
          },
          "WorkerUrl": {
            "minLength": 1,
            "type": "string",
            "description": "Worker URL exactly as displayed by balancer-manager (e.g. \"https://web-public.app-1.example.com\")."
          },
          "ActionType": {
            "minLength": 1,
            "type": "string",
            "description": "Action to apply, case-insensitive. One of: Enable, Disable, Drain, Stop, DisableOff, DrainOff, StopOff, IgnoreErrorsOn, IgnoreErrorsOff, HotStandbyOn, HotStandbyOff, HotSpareOn, HotSpareOff, HcFailOn, HcFailOff."
          }
        },
        "additionalProperties": false,
        "description": "Request to change the status of one worker on one Apache server."
      },
      "WorkerActionResultDto": {
        "type": "object",
        "properties": {
          "ServerId": {
            "type": "string",
            "description": "Identifier of the Apache server the action was applied on.",
            "nullable": true
          },
          "BalancerName": {
            "type": "string",
            "description": "Balancer pool the worker belongs to.",
            "nullable": true
          },
          "WorkerUrl": {
            "type": "string",
            "description": "Worker URL the action targeted.",
            "nullable": true
          },
          "ActionApplied": {
            "type": "string",
            "description": "Canonical name of the action that was applied.",
            "nullable": true
          },
          "NewStatus": {
            "$ref": "#/components/schemas/WorkerStatusDto"
          }
        },
        "additionalProperties": false,
        "description": "Result of a successfully applied worker action."
      },
      "WorkerStatusDto": {
        "type": "object",
        "properties": {
          "Url": {
            "type": "string",
            "description": "Worker URL exactly as Apache displays it (e.g. \"https://10.0.0.23\").",
            "nullable": true
          },
          "Route": {
            "type": "string",
            "description": "Session route of the worker.",
            "nullable": true
          },
          "RouteRedir": {
            "type": "string",
            "description": "Route redirection target.",
            "nullable": true
          },
          "LoadFactor": {
            "type": "number",
            "description": "Load factor (the \"Factor\" column), e.g. 1.00.",
            "format": "double"
          },
          "Set": {
            "type": "string",
            "description": "Load-balancer set (\"Set\" column).",
            "nullable": true
          },
          "RawStatus": {
            "type": "string",
            "description": "Raw status text as displayed by Apache (e.g. \"Init Stby Ok\").",
            "nullable": true
          },
          "StatusFlags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Individual status flags split from ApacheBalancerBFF.Dtos.WorkerStatusDto.RawStatus (e.g. [\"Init\",\"Stby\",\"Ok\"]). Known tokens include Init, Ok, Dis, Drn, Stby, Spar, Ign, Stop, Err, HcFl.",
            "nullable": true
          },
          "Elected": {
            "type": "string",
            "description": "Number of times the worker was elected.",
            "nullable": true
          },
          "Busy": {
            "type": "string",
            "description": "Current busy count.",
            "nullable": true
          },
          "Load": {
            "type": "string",
            "description": "Current load score.",
            "nullable": true
          },
          "To": {
            "type": "string",
            "description": "Bytes sent to the worker (\"To\" column).",
            "nullable": true
          },
          "From": {
            "type": "string",
            "description": "Bytes received from the worker (\"From\" column).",
            "nullable": true
          },
          "HealthCheckMethod": {
            "type": "string",
            "description": "Health-check method (e.g. \"GET\", \"NONE\"). Empty when the column is absent.",
            "nullable": true
          },
          "HealthCheckInterval": {
            "type": "string",
            "description": "Health-check interval (e.g. \"5000ms\").",
            "nullable": true
          },
          "HealthCheckPasses": {
            "type": "string",
            "description": "Health-check passes trigger (e.g. \"2 (0)\").",
            "nullable": true
          },
          "HealthCheckFails": {
            "type": "string",
            "description": "Health-check fails trigger (e.g. \"4 (0)\").",
            "nullable": true
          },
          "HealthCheckUri": {
            "type": "string",
            "description": "Health-check URI.",
            "nullable": true
          },
          "HealthCheckExpr": {
            "type": "string",
            "description": "Health-check expression.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "One backend worker row scraped from a balancer pool's worker table."
      }
    }
  },
  "tags": [
    {
      "name": "ApacheBalancerBFF"
    },
    {
      "name": "Balancer"
    }
  ]
}